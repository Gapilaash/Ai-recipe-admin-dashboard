# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# Production: use the SAME Postgres URL as the main site. Locally leave empty -> uses a local SQLite file.
DATABASE_URL=

# Pro price used for revenue estimates (keep in sync with the main site)
PRO_PRICE_NUM=7.99

# First admin is created on first sign-in with these (then you can delete ADMIN_PASSWORD).
ADMIN_USERNAME=
ADMIN_PASSWORD=
